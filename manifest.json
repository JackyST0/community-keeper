{
  "manifest_version": 3,
  "name": "Community Keeper",
  "description": "Run community daily tasks with the current browser login session.",
  "version": "0.1.1",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Community Keeper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.v2ex.com/*",
    "https://v2ex.com/*",
    "https://www.nodeseek.com/*",
    "https://nodeseek.com/*",
    "https://linux.do/*",
    "https://connect.linux.do/*",
    "https://forum.naixi.net/*",
    "https://*.naixi.net/*"
  ]
}
